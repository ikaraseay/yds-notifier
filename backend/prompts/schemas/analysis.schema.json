{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://yds-notifier.local/schemas/analysis.schema.json",
  "title": "NoticeAnalysisResponse",
  "description": "批量通知 AI 分析的输出契约。运行时由 backend/ai/schema.py 做等价校验，不依赖 jsonschema 库。",
  "type": "object",
  "required": ["notices"],
  "additionalProperties": false,
  "properties": {
    "notices": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object",
        "required": ["uid", "category", "summary", "urgency", "events"],
        "additionalProperties": false,
        "properties": {
          "uid": { "type": "string", "minLength": 1, "maxLength": 200 },
          "category": {
            "type": "string",
            "enum": ["报名参赛", "评审与名单", "决赛与收官", "赛事动态", "其他通知"]
          },
          "summary": { "type": "string", "maxLength": 200 },
          "urgency": {
            "type": "string",
            "enum": ["critical", "high", "normal", "low"]
          },
          "reason": { "type": "string", "maxLength": 120 },
          "events": {
            "type": "array",
            "maxItems": 4,
            "items": {
              "type": "object",
              "required": ["evidence", "label", "kind"],
              "additionalProperties": false,
              "properties": {
                "evidence": { "type": "string", "minLength": 4, "maxLength": 60 },
                "label": { "type": "string", "maxLength": 40 },
                "kind": {
                  "type": "string",
                  "enum": ["deadline", "event", "notice", "other"]
                },
                "location": { "type": "string", "maxLength": 100 },
                "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
              }
            }
          },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
        }
      }
    }
  }
}
