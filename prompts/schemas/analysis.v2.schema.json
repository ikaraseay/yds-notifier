{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://yds-notifier.local/schemas/analysis.v2.schema.json",
  "title": "NoticeAnalysisResponseV2",
  "description": "v2：在分类/摘要/紧急度基础上增加赛事、阶段、人群与行动建议。运行时由 yds/ai/schema.py 做等价校验。",
  "type": "object",
  "required": ["notices"],
  "additionalProperties": false,
  "properties": {
    "notices": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object",
        "required": ["uid", "category", "summary", "urgency", "events"],
        "additionalProperties": false,
        "properties": {
          "uid": { "type": "string", "minLength": 1, "maxLength": 200 },
          "contest": {
            "type": "string",
            "enum": [
              "", "智慧城市技术与创意设计大赛", "未来飞行器创新大赛", "数学建模竞赛",
              "电子设计竞赛", "创“芯”大赛", "EDA精英挑战赛", "人工智能创新大赛",
              "机器人创新设计大赛", "能源装备创新设计大赛", "公共管理案例大赛",
              "乡村振兴科技强农+创新大赛", "网络安全创新大赛", "“双碳”创新与创意大赛",
              "金融科技创新大赛", "“美丽中国”创新设计大赛", "企业管理创新大赛",
              "操作系统开源创新大赛", "“文化中国”两创大赛", "国际中文教育案例大赛",
              "智能建造创新大赛"
            ]
          },
          "stage": {
            "type": "string",
            "enum": ["报名", "资格审查", "缴费", "提交作品", "评审", "决赛", "公示", "获奖", "报销", "承办", "动态", "其他", ""]
          },
          "audiences": {
            "type": "array",
            "maxItems": 4,
            "items": { "type": "string", "enum": ["student", "advisor", "admin", "organizer"] }
          },
          "action": { "type": "string", "maxLength": 90 },
          "category": {
            "type": "string",
            "enum": ["报名参赛", "评审与名单", "决赛与收官", "赛事动态", "其他通知"]
          },
          "summary": { "type": "string", "maxLength": 200 },
          "urgency": {
            "type": "string",
            "enum": ["critical", "high", "normal", "low"]
          },
          "reason": { "type": "string", "maxLength": 120 },
          "events": {
            "type": "array",
            "maxItems": 4,
            "items": {
              "type": "object",
              "required": ["evidence", "label", "kind"],
              "additionalProperties": false,
              "properties": {
                "evidence": { "type": "string", "minLength": 4, "maxLength": 60 },
                "label": { "type": "string", "maxLength": 40 },
                "kind": {
                  "type": "string",
                  "enum": ["deadline", "event", "notice", "other"]
                },
                "location": { "type": "string", "maxLength": 100 },
                "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
              }
            }
          },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
        }
      }
    }
  }
}
