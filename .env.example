# ============================================================================
# 研电赛通知订阅器 —— 配置（单一事实源）
#
#   cp .env.example .env     填真实值。.env 已被 .gitignore 忽略，绝不入库。
#
# 三条设计原则
#   1. 每个值只填一次：能推导出来的绝不重复填（URL、发件人显示名都自动派生）
#   2. 跨平台共享的密钥「同名同值」：Cloudflare 与 GitHub 各填一次，名字一样
#   3. 每项标注去处：
#        [CF-V] Cloudflare → Variables and Secrets → 明文变量
#        [CF-S] Cloudflare → Variables and Secrets → Secret（加密）
#        [GH]   GitHub → Secrets and variables → Actions → Secrets
#        [构建] Cloudflare Workers Builds → Build variables（只在构建期可见）
#        [本地] 只在本地 / 文档参考，不需要填到云端
#
# 谁读这个文件
#   Python / GitHub Actions : 直接读（CI 上由同名 Secrets 覆盖）
#   Cloudflare Worker       : 不读本文件。生产值填 Dashboard 的 [CF-V] / [CF-S]；
#                             本地调试用 cloudflare/.dev.vars（Wrangler 只读 cloudflare/ 同目录）
#   wrangler.toml           : 由 `npm run sync-config` 从本文件同步域名与 KV id
#
# 优先级：进程环境变量（CI / Cloudflare 注入）> .env > 内置默认值
# ============================================================================

# ────────────────────────────────────────────────────────────────────────────
# 1. 域名与站点身份
#    只需填 CUSTOM_DOMAIN（或首次部署时填 WORKERS_DEV_URL）。
#    下面这些全部自动派生，不用再填：
#       PUBLIC_BASE_URL   = 显式值 || https://<CUSTOM_DOMAIN> || <WORKERS_DEV_URL>
#       UNSUB_URL         = <PUBLIC_BASE_URL>/unsubscribe   （对外链接，用自定义域）
#       SUBSCRIBE_API_URL = <WORKERS_DEV_URL>/api/list      （机器接口，绕开 zone WAF）
#       NOTICES_API_URL   = <WORKERS_DEV_URL>/api/notices   （同上，失败自动回退自定义域）
#       MAIL_FROM         = "MAIL_FROM_NAME <MAIL_FROM_ADDRESS>"
# ────────────────────────────────────────────────────────────────────────────

# 自定义域名，仅 hostname，不带 https:// 和路径。
# 绑定后 Cloudflare 自动创建 DNS 记录与证书（域名需托管在 Cloudflare）。
# 留空 = 只使用 workers.dev 地址，适合「先部署、后绑域名」。
CUSTOM_DOMAIN="notice.your-domain.com"                                  # [CF-V] 可选 + [构建]

# 首次部署拿到的 *.workers.dev 地址。CUSTOM_DOMAIN 为空时作为主地址，
# 同时始终作为 CSRF 同源白名单的一员（自定义域生效后仍可从 workers.dev 访问）。
# 另外：Actions 的 /api/list、/api/notices 机器调用默认走它 —— 自定义域挂在
# zone 下，机房 IP 可能被 Cloudflare 托管质询（HTTP 403 "Just a moment..."）拦截；
# 填了它就能绕开，失败时仍会自动回退到自定义域。
WORKERS_DEV_URL="https://yds-unsubscribe.<你的子域>.workers.dev"        # [CF-V] 可选 + [本地]

# 高级覆盖：一般留空。填了就以它为准（例如反向代理或带路径的场景）。
# 必须是 https 完整地址、不带结尾斜杠；本地调试可用 http://localhost:8787。
PUBLIC_BASE_URL=""                                                       # [CF-V] 可选

SITE_NAME="研电赛通知订阅"                                              # [CF-V] + [GH] 可选
REPO_URL="https://github.com/<你的用户名>/yds-notifier"                  # [本地]（CI 自动注入）

# ────────────────────────────────────────────────────────────────────────────
# 2. 发信通道
# ────────────────────────────────────────────────────────────────────────────
MAIL_PROVIDER="resend"                     # resend | smtp              # [GH] 可选，默认 resend
# 发件域名与站点域名互相独立：站点可以是 notice.yds.example.com，
# 而 Resend 只要验证根域 example.com，就能用 notice@example.com 发信。
# 注意：Resend → Domains 里填的是「发件域」，不是 CUSTOM_DOMAIN。
MAIL_FROM_ADDRESS="notice@your-domain.com" # 已验证域名下的纯地址        # [CF-V] 必填 + [GH] 必填
MAIL_FROM_NAME="研电赛通知"                                            # [CF-V] + [GH] 可选
MAIL_TO="you@qq.com"                       # 站长邮箱，逗号分隔          # [CF-V] 必填 + [GH] 必填
REPLY_TO=""                                                             # [GH] 可选
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxx"                            # [CF-S] 必填 + [GH] 必填

# Resend Webhook 的签名密钥（whsec_...）。在 Resend → Webhooks 添加端点：
#   https://<PUBLIC_BASE_URL>/api/webhooks/resend
# 勾选 email.bounced / email.complained / suppression.added，复制 Signing Secret。
# 留空时 webhook 端点返回 503（fail-closed），不会被伪造请求删订阅者。
RESEND_WEBHOOK_SECRET=""                                                # [CF-S] 可选

# SMTP 兜底（MAIL_PROVIDER=smtp 时才需要）
SMTP_HOST="smtp.qq.com"                                                  # [GH] 可选
SMTP_PORT="465"                                                          # [GH] 可选
SMTP_SECURITY="ssl"                                                      # [GH] 可选
SMTP_USER=""                                                             # [GH] 可选
SMTP_PASSWORD=""                                                         # [GH] 可选

# ────────────────────────────────────────────────────────────────────────────
# 3. 共享密钥：Cloudflare 与 GitHub 填「同名、同值」
#    生成：openssl rand -hex 32（两个值不要复用）
# ────────────────────────────────────────────────────────────────────────────
UNSUB_SECRET="replace-with-32-byte-random-hex"                          # [CF-S] 必填 + [GH] 必填
SUBSCRIBE_API_TOKEN="replace-with-another-32-byte-random-hex"           # [CF-S] 必填 + [GH] 必填
UNSUB_SECRET_PREVIOUS=""         # 密钥轮换期的旧值，留空即关闭         # [CF-S] 可选

# 兼容旧部署：Worker 仍识别 ADMIN_TOKEN、UNSUB_URL、SUBSCRIBE_API_URL。
# 管理后台（仅 Cloudflare）。运行 bash scripts/ops.sh admin-secrets 自动填写并上传。
ADMIN_PASSWORD_HASH=""                                               # [CF-S] 可选
ADMIN_SESSION_SECRET=""                                              # [CF-S] 可选

# 新部署不需要这两个 URL，也不需要 ADMIN_TOKEN。

# ────────────────────────────────────────────────────────────────────────────
# 3.5 AI 分析（仅 GitHub Actions 使用；Cloudflare Worker 不调模型）
#     使用 OpenAI 兼容接口，默认 DeepSeek。换 provider 只改 BASE_URL / MODEL。
#     提示词在 backend/prompts/ 目录，版本由 backend/prompts/manifest.yaml 的 active 决定，
#     升版会自动让 data/ai.json 缓存全量失效重算，无需在此配置。
# ────────────────────────────────────────────────────────────────────────────
AI_ENABLED="true"                    # 关掉即退回关键词分类 + 正则日期      # [GH] 可选
AI_API_KEY=""                        # DeepSeek 控制台创建                   # [GH] Secret 必填
AI_BASE_URL="https://api.deepseek.com"                                     # [GH] 可选
AI_MODEL="deepseek-flash"            # deepseek-flash / deepseek-v4-pro     # [GH] 可选
AI_THINKING="false"                  # 默认关闭：稳定 JSON、低延迟、更便宜    # [GH] 可选
AI_TEMPERATURE="0.1"                 # 仅非 thinking 模式生效                # [GH] 可选
AI_MAX_TOKENS="4096"                 # 留够，否则 JSON 会被截断              # [GH] 可选
AI_TIMEOUT="60"                                                             # [GH] 可选
AI_BATCH_SIZE="8"                    # 单次请求分析多少条通知                # [GH] 可选
AI_MAX_BODY_CHARS="3000"             # 单条正文截断长度                      # [GH] 可选

# ────────────────────────────────────────────────────────────────────────────
# 4. 可选运行参数（仅 Cloudflare 明文变量）
# ────────────────────────────────────────────────────────────────────────────
UNSUB_TTL_DAYS="180"             # 退订链接有效天数，两端填同值        # [CF-V] + [GH] 可选
MAX_PER_IP_HOUR="10"             # 每 IP 每小时登录提交次数             # [CF-V] 可选
MAX_CONFIRM_PER_DAY="200"        # 全局每天登录邮件上限                 # [CF-V] 可选
LIST_RATE_PER_HOUR="60"          # /api/list 每 IP 每小时上限           # [CF-V] 可选

# 归档 / RSS / 日历：Python 抓到通知后同步给 Worker（内容无变化时不写 KV）
PUBLISH_NOTICES="true"           # false 可临时关闭同步                   # [GH] 可选
NOTICES_API_URL=""               # 留空 = <PUBLIC_BASE_URL>/api/notices    # [GH] 可选

# 抓取标识与 robots.txt 策略（合规相关，见 README「数据来源与免责声明」）
CRAWLER_UA=""                    # 留空 = yds-notifier/1.0 (+仓库地址)     # [GH] 可选
RESPECT_ROBOTS="enforce"         # enforce 命中 Disallow 即跳过 / warn 只记日志 / off 不校验
                                 # 目标站 robots.txt 为 Disallow: /，改成 warn 即表示
                                 # 部署者自行承担合规责任                        # [GH] 可选

# ────────────────────────────────────────────────────────────────────────────
# 3.5 状态存储（Cloudflare R2，REST API）
#   不填 = 继续用 data/*.json + git 回写（旧行为，完全兼容）。
#   填了就把运行状态放对象存储：不再有 bot commit、不再 rebase 冲突，
#   且远端 gzip 后约 166 KB（原 572 KB）。
#   只需账户级 CLOUDFLARE_API_TOKEN（Workers R2 Storage Read/Write）+ R2_BUCKET。
# ────────────────────────────────────────────────────────────────────────────
STATE_BACKEND="auto"                  # auto | local（强制走 git）          # [GH] 可选
R2_BUCKET=""                          # 桶名，例如 yds-state                # [GH] 可选
R2_PREFIX="state"                     # 对象前缀，多个环境可共用同一个桶     # [GH] 可选

# 失败告警与心跳（GitHub Actions）
# HEARTBEAT_URL 填外部 dead-man switch 的 ping 地址（Healthchecks / Better Stack 等），
# 「该来没来」就会告警，能覆盖定时任务被 60 天规则禁用、抓取静默停摆。
# ALERT_WEBHOOK_URL 填失败时接收 POST JSON 的 webhook（企业微信 / 飞书 / Slack 等）；
# 不填时失败运行会显式报 ::error::，不会静默通过。
HEARTBEAT_URL=""                                                        # [GH] 可选
ALERT_WEBHOOK_URL=""                                                    # [GH] 可选

# ────────────────────────────────────────────────────────────────────────────
# 5. Cloudflare 资源 ID 与部署凭据（不注入 Worker 运行时）
# ────────────────────────────────────────────────────────────────────────────
# wrangler kv namespace create SUBS 的输出，由 npm run sync-config 写进 wrangler.toml。
KV_SUBS_ID="replace-with-your-kv-namespace-id"                           # [构建] + [本地]

# 一个账户级 Token 完成部署、上传密钥、R2 状态读写（账户级 API Token，
# 不是用户级 / R2 S3 密钥）。只有 GitHub Actions 兜底部署与 R2 状态需要它：
# 前者读 GitHub Secrets，后者在 Actions 里读同名 Secrets。
CLOUDFLARE_ACCOUNT_ID=""                                                 # [GH] Secret
CLOUDFLARE_API_TOKEN=""                                                  # [GH] Secret
