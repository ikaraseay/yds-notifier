# ===== 密钥与本地配置（最高优先级，绝不入库） =====
.env
.env.*
!.env.example
.dev.vars
.dev.vars.*
!.dev.vars.example
*.pem
*.key
*.p12

# ===== Python =====
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.mypy_cache/

# ===== Node / Cloudflare Worker =====
node_modules/
dist/
.wrangler/
*.tsbuildinfo
worker/.dev.vars

# ===== 运行时产物 =====
*.log
*.tmp
preview.html
.DS_Store
# 单实例运行锁：进程退出自动释放，不入库
data/.run.lock
data/.state-push-failed
data/*.tmp
data/*.r2tmp
# R2 状态的本地预览副本（scripts/r2_state.py pull 默认落这里）
.r2-preview/

# 保留去重状态文件（Actions 需要提交它）
!data/seen.json

# WorkBuddy 工作区数据（本地记忆/日志，不入库）
.workbuddy/
